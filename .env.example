# Copy to .env.local for local overrides. All optional — defaults are in code.

# Sanity project the site reads from (public, read-only)
NEXT_PUBLIC_SANITY_PROJECT_ID=gqkhy2kv
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical site URL used for link previews, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://lovique-studio.vercel.app
